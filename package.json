{
  "name": "miniclip",
  "version": "1.0.0",
  "description": "A simple clipboard manager for Linux",
  "author": "Aditya Verma <wweverma1@gmail.com> (https://github.com/wweverma1)",
  "contributors": [
    "undefinederror <github@object.ninja> (https://github.com/undefinederror)"
  ],
  "license": "GPL-3.0-only",
  "private": true,
  "desktopName": "com.miniclip.app.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "electron-builder install-app-deps",
    "prebuild": "node scripts/update-metainfo.mjs",
    "build": "tsc && vite build && electron-builder --linux",
    "build:publish": "npm run build -- --publish always",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss": "^8.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js"
}
